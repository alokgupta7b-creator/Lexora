# Local development database
DATABASE_URL=sqlite:///./ai_detector_local.db

# Redis Caching Configuration
REDIS_URL=redis://localhost:6379/0

# Generate values for Docker Compose before starting:
# SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# POSTGRES_PASSWORD: choose a strong, unique password
SECRET_KEY=
POSTGRES_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local Storage MVP Paths
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# Optional production-grade Cloud Storage integrations (AWS S3 Ready)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
USE_S3=false

# Optional API Keys (Unlocks premium LLM Paraphrases/Humanizers)
OPENAI_API_KEY=
HF_API_KEY=

# Next.js API endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
